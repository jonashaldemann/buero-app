# macOS
.DS_Store

# Banana-Exporte enthalten echte Umsatz-/Aufwandszahlen -- nie ins (öffentliche!)
# Repo committen. Kontenplan/Kategorien/MwSt-Codes werden manuell (ohne Beträge)
# in js/app.js gepflegt, siehe README.
*.jcsv

# Kontenplan/Kategorien enthalten Projekt-/Kundennamen -- liegen vertraulich
# auf Nextcloud statt im (öffentlichen!) Repo, siehe README ("Beleg erfassen")
# und Kommentar bei MASTERDATA_FOLDER_PATH in quittung/app.js. Lokal bleiben
# sie als Arbeitskopie bestehen (nur von git ignoriert, nicht gelöscht).
quittung/konten.txt
quittung/kategorien.txt

# Absenderadresse fürs Offerten-Briefpapier enthält echte Geschäftsdaten
# (Adresse, Telefon, Mail, Website) -- liegt deshalb vertraulich auf
# Nextcloud (ABSENDER_FILENAME in offerten/app.js) statt im (öffentlichen!)
# Repo. Lokal bleibt die Datei als Arbeitskopie bestehen (nur von git
# ignoriert, nicht gelöscht).
offerten/absender.json

# Der vollständige BKP-Katalog nach SN 506 500:2017 ist urheberrechtlich
# geschützt (CRB) und gehört NICHT ins (öffentliche!) Repo. Er liegt als
# "_bkp_katalog.json" auf Nextcloud neben den Kostenschätzungen und wird von
# baukosten/app.js nach dem Anmelden geladen (ladeKatalog()). Im Repo steht
# nur der gröbere Grundkatalog baukosten/bkp.js. Diese Zeilen fangen eine
# versehentlich hereinkopierte Arbeitskopie ab.
_bkp_katalog.json
_bkp_sn506500_2017.json
